# Install a filled copy outside the repository with mode 0600; never commit it.
# Resend HTTPS API (works even when outbound SMTP ports are blocked).
EMAIL_TRANSPORT=resend
RESEND_API_KEY=
# Optional SMTP alternative: set EMAIL_TRANSPORT=smtp and use the API key as SMTP_PASSWORD.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
# Leave blank for HTTPS API mode.
SMTP_PASSWORD=
SMTP_FROM="AntikPoker <noreply@antikpoker.online>"
EMAIL_VERIFICATION_SECRET=
PUBLIC_BASE_URL=https://antikpoker.online

# Preserve the existing PLAYER_SESSION_SECRET / USER_AUTH_SECRET values.
# Production also requires NODE_ENV=production and configured ADMIN_PASSWORD.
# TRUST_PROXY must match the real trusted proxy topology, not arbitrary clients.
